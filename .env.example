# Camly 環境変数テンプレート。値は空。本番の秘密情報はここに書かず、Vercelのプロジェクト設定で管理する。
# Master Handoff v2 §5, §8, §17 準拠。

# --- Database -----------------------------------------------------------
# PostgreSQL接続文字列(Supabase等)。時刻はUTC保存前提。
DATABASE_URL=

# --- Stripe ---------------------------------------------------------------
# test mode の秘密鍵から開始する。live mode切替はLAUNCH_BLOCKERS.mdの条件を満たしてから。
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhookエンドポイントのsigning secret(署名検証に必須。§8.1)
STRIPE_WEBHOOK_SECRET=

# --- Box連携(Phase B) -----------------------------------------------------
# BoxCommand署名用の共有鍵(HMAC-SHA256)。OEM選定後、鍵交換方式を再検討する(§12.3)。
BOX_COMMAND_SIGNING_SECRET=
# feature flag: Phase B(スマートボックス)を有効化するか。Phase Aの間はfalseのまま。
BOX_PROVIDER_MODE=simulator
# simulator | oem_adapter (未実装。OEM選定後に追加)

# --- 認証/管理画面 ----------------------------------------------------------
# 管理画面セッション用シークレット
ADMIN_SESSION_SECRET=

# --- メディアストレージ(返却動画・写真) -------------------------------------
# S3互換オブジェクトストレージ。署名URLで配信する(§17)。
MEDIA_STORAGE_ENDPOINT=
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_REGION=auto
MEDIA_STORAGE_ACCESS_KEY_ID=
MEDIA_STORAGE_SECRET_ACCESS_KEY=

# --- メール通知 -------------------------------------------------------------
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# --- feature flags ----------------------------------------------------------
# 別拠点返却(§14: 初期はOFF)
FEATURE_CROSS_LOCATION_RETURN=false
# /locations 一覧の公開(未確定情報が揃うまではfalse推奨)
FEATURE_PUBLIC_LOCATIONS_PAGE=false

# --- アプリ全般 --------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://camly-plum.vercel.app
NEXT_PUBLIC_DEFAULT_LOCALE=ja
